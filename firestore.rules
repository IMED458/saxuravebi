rules_version = '2';
// ⚠️ პროგრამა იყენებს საკუთარ (username/password) ავტორიზაციას, არა Firebase Auth-ს.
// ამიტომ Firestore-ის წვდომა ღიაა. თუ დამატებით დაცვა გინდა, გამოიყენე
// Firebase App Check ან გადაიყვანე Firebase Authentication-ზე.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
